{
  "name": "synthwerk-widgets",
  "version": "0.4.0",
  "private": true,
  "description": "Synthwerk embeddable widgets (chat, vision): one script tag, one custom element each",
  "license": "MIT",
  "author": "Velimir Mueller",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "build": "vite build && vite build --mode vision",
    "demo": "vite build && node tests/e2e/serve.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@synthwerk/sdk": "file:vendor/synthwerk-sdk",
    "@synthwerk/tokens": "file:vendor/synthwerk-tokens",
    "@synthwerk/ui-vue": "file:vendor/synthwerk-ui-vue",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
