{
  "name": "@synthwerk/sdk",
  "version": "0.3.0",
  "description": "Synthwerk SDK core: token sign-in, typed API client and chat stream client. Framework-free, browser and Node 24",
  "license": "MIT",
  "author": "Velimir Mueller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelimirMueller/synthwerk-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/VelimirMueller/synthwerk-sdk/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/VelimirMueller/synthwerk-sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "eventsource-parser": "4.1.1",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "codegen": "node scripts/codegen.ts",
    "codegen:sync": "node scripts/codegen.ts --sync"
  }
}