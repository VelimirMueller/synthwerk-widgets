  "description": "Synthwerk UI components for Vue 3.5 (synthwerk-ui). Read @synthwerk/tokens only",
  "license": "MIT",
  "author": "Velimir Mueller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelimirMueller/synthwerk-sdk.git",
